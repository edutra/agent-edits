#!/usr/bin/env python3
"""Agent hook: records every file an AI agent edits.

Registered for PreToolUse and PostToolUse on the agents' edit tools. Reads the
hook event (JSON) from stdin.

PreToolUse   saves a baseline of each file the tool is about to touch, once
             per agent session, in baselines/<session>/<sha256(path)>, so the
             viewer can diff against the file as it was before the session.
PostToolUse  appends one line per edited file to edits.tsv:
               <epoch> <agent> <path> <project> <session>
             <project> is the directory the agent session was started in.

Also a maintenance command, used by the viewer:
  agent-edits-log --clear DIR [--dry-run]   forget the edits of the project in DIR
  agent-edits-log --clear-all [--dry-run]   forget every edit
Both print the number of log lines removed (or that would be).

Everything lives in $XDG_STATE_HOME/agent-edits. Works with Claude Code
(tool_name/tool_input), Grok (toolName/toolInput, also loads Claude's hooks)
and Codex (apply_patch patch text). It never fails the agent: any error is
swallowed and the exit code is always 0.
"""
import fcntl
import hashlib
import json
import os
import re
import shutil
import sys
import time

STATE_DIR = os.path.join(
    os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
    "agent-edits",
)
LOG = os.path.join(STATE_DIR, "edits.tsv")
BASELINES = os.path.join(STATE_DIR, "baselines")
PRUNE_BYTES = 1_000_000
KEEP_SECONDS = 14 * 24 * 3600
MAX_BASELINE_BYTES = 2_000_000

PATH_KEYS = ("file_path", "filePath", "path", "target_file", "targetFile", "notebook_path")
PATCH_RE = re.compile(r"^\*\*\* (?:(?:Add|Update|Delete) File|Move to): (.+)$", re.M)
# Grok's camelCase event names, mapped to the names Claude and Codex use.
GROK_EVENTS = {"pre_tool_use": "PreToolUse", "post_tool_use": "PostToolUse"}


def collect(value, found):
    """Walk the tool input, picking explicit path keys and patch headers."""
    if isinstance(value, dict):
        for key, item in value.items():
            if key in PATH_KEYS and isinstance(item, str) and item.strip():
                found.append(item.strip())
            else:
                collect(item, found)
    elif isinstance(value, list):
        for item in value:
            collect(item, found)
    elif isinstance(value, str) and "*** " in value:
        found.extend(m.strip() for m in PATCH_RE.findall(value))


def event_name(event):
    name = event.get("hook_event_name") or GROK_EVENTS.get(event.get("hookEventName", ""), "")
    return name or "PostToolUse"


def agent_name(event):
    # Grok runs the hooks it finds in ~/.claude/settings.json and adds camelCase keys.
    if "hookEventName" in event:
        return "Grok"
    return sys.argv[1] if len(sys.argv) > 1 else "agent"


def session_id(event):
    sid = str(event.get("session_id") or event.get("sessionId") or "")
    sid = re.sub(r"[^A-Za-z0-9._-]", "_", sid)[:80]
    return sid or "-"


def project_dir(event, cwd):
    """The directory the agent session was started in.

    Not the git root: a repository higher up (e.g. a dotfiles repo in $HOME)
    would merge unrelated projects. Grok sets CLAUDE_PROJECT_DIR to its git
    workspace root, so its event cwd (the launch directory) is used instead.
    """
    if "hookEventName" in event:
        base = event.get("cwd") or cwd
    else:
        base = os.environ.get("CLAUDE_PROJECT_DIR") or cwd
    return os.path.normpath(os.path.expanduser(base))


def edited_paths(event, cwd):
    found = []
    collect(event.get("tool_input", event.get("toolInput")), found)
    paths = []
    for p in found:
        p = os.path.expanduser(p)
        if p.startswith("file://"):
            p = p[len("file://"):]
        p = os.path.normpath(os.path.join(cwd, p))
        if p not in paths:
            paths.append(p)
    return paths


def baseline_key(path):
    return hashlib.sha256(path.encode()).hexdigest()


def save_baselines(session, paths):
    """Keep each file as it was before the session's first edit to it."""
    if session == "-":
        return
    folder = os.path.join(BASELINES, session)
    os.makedirs(folder, exist_ok=True)
    for path in paths:
        base = os.path.join(folder, baseline_key(path))
        if any(os.path.exists(base + ext) for ext in ("", ".new", ".skip")):
            continue
        if not os.path.exists(path):
            open(base + ".new", "w").close()
        elif not os.path.isfile(path) or os.path.getsize(path) > MAX_BASELINE_BYTES:
            open(base + ".skip", "w").close()
        else:
            shutil.copyfile(path, base + ".tmp")
            os.replace(base + ".tmp", base)


def prune():
    """Drop log lines and baselines older than KEEP_SECONDS once the log is big."""
    try:
        if os.path.getsize(LOG) < PRUNE_BYTES:
            return
        cutoff = time.time() - KEEP_SECONDS
        with open(LOG, encoding="utf-8", errors="replace") as fh:
            lines = [l for l in fh if l.split("\t", 1)[0].isdigit() and int(l.split("\t", 1)[0]) >= cutoff]
        with open(LOG, "w", encoding="utf-8") as fh:
            fh.writelines(lines)
        if os.path.isdir(BASELINES):
            for entry in os.scandir(BASELINES):
                if entry.is_dir() and entry.stat().st_mtime < cutoff:
                    shutil.rmtree(entry.path, ignore_errors=True)
    except OSError:
        pass


def log_edits(event, paths, cwd):
    agent = agent_name(event)
    project = project_dir(event, cwd)
    session = session_id(event)
    now = int(time.time())
    with open(LOG, "a", encoding="utf-8") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        fh.writelines(f"{now}\t{agent}\t{p}\t{project}\t{session}\n" for p in paths)
        prune()


def under(path, folder):
    return path == folder or path.startswith(folder.rstrip("/") + "/")


def in_project(path, project, root):
    """Same rule as the viewer's project filter (nvim/viewer.lua in_project)."""
    if under(path, root):
        return True
    if not project:
        return False
    if under(project, root):
        return True
    return under(root, project) and project not in (os.path.expanduser("~"), "/")


def clear(root, dry_run):
    """Remove log lines (all of them when root is None), then baselines of
    sessions that no longer appear in the log. Prints the number removed."""
    if not os.path.exists(LOG):
        print(0)
        return
    root = os.path.normpath(root) if root else None
    with open(LOG, "r+", encoding="utf-8", errors="replace") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        kept, removed = [], 0
        for line in fh:
            cols = line.rstrip("\n").split("\t")
            path = cols[2] if len(cols) > 2 else ""
            project = cols[3] if len(cols) > 3 else ""
            if root is None or in_project(path, project, root):
                removed += 1
            else:
                kept.append(line)
        if not dry_run and removed:
            fh.seek(0)
            fh.writelines(kept)
            fh.truncate()
            sessions = {l.rstrip("\n").split("\t")[4] for l in kept if l.count("\t") >= 4}
            if os.path.isdir(BASELINES):
                for entry in os.scandir(BASELINES):
                    if entry.is_dir() and entry.name not in sessions:
                        shutil.rmtree(entry.path, ignore_errors=True)
    print(removed)


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("--clear", "--clear-all"):
        dry_run = "--dry-run" in sys.argv
        args = [a for a in sys.argv[2:] if a != "--dry-run"]
        clear(args[0] if sys.argv[1] == "--clear" else None, dry_run)
        return
    raw = sys.stdin.read()
    os.makedirs(STATE_DIR, exist_ok=True)
    if os.environ.get("AGENT_EDITS_DEBUG"):
        with open(os.path.join(STATE_DIR, "debug.jsonl"), "a", encoding="utf-8") as fh:
            fh.write(raw.strip() + "\n")

    event = json.loads(raw)
    cwd = event.get("cwd") or event.get("workspaceRoot") or os.getcwd()
    paths = edited_paths(event, cwd)
    if not paths:
        return
    if event_name(event) == "PreToolUse":
        save_baselines(session_id(event), paths)
    else:
        log_edits(event, paths, cwd)


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass
    sys.exit(0)
